node_modules/
*.log
.DS_Store
Thumbs.db

# Owner-only memory snapshots produced by the "download Markdown" button.
# These contain personal long-term memories; never commit them.
dsh-memory-*.md

# Local design/API notes produced while building against a specific DSH build.
docs/research/

# Scratch directories used by the self-tests and the pre-clean helper.
tools/.tmp/
# Rendered samples from tools/preview-export.mjs (regenerate on demand).
tools/preview/

# local screenshot captures
shots/

# Scratch output from asar extraction/inspection while reverse-engineering a DSH build.
.asar-x/
.asar-list/


# asar inspection scratch
/asar-sched/
/x/


refs/

# Scratch checkouts of third-party plugins read while comparing features
# (~144 MB of extracted source; refetch from codeload when needed).
.market-review/

# Commit message scratch passed to git -F (avoid PowerShell mangling the text).
.git-commit-msg.txt

# Local user data: full memory-store backups, split audits, ACL diagnostics.
# NEVER commit these — they contain private long-term memories (incl. secret
# entries) and are only for local rollback.
_memory-backup/
_acl-recovery/

# One-off maintenance/analysis notes that quote real long-term memory text.
# Keep local only; never publish to the public repository.
docs/memory-lesson-split-plan.md
tools/lesson-split-data.mjs
tools/_decay-audit.mjs
tools/_pre-reboot-audit.mjs
tools/_validate-patch.mjs
tools/apply-lesson-split.mjs
tools/repair-after-exit.mjs

# Isolated v4 embedding probe (installs onnxruntime ~113MB). Never commit.
_v4-isolation/

# Short-lived v4 install probe (onnxruntime ~113MB). Never commit.
_v4-test/

# Archived profile backups (compressed). Local only.
_old-backups*.zip

# Benchmark authoring data + results quote real long-term memory text (want-
# fragments, top-5 previews). Same rule as lesson-split-data: local only.
tools/benchmark/queries.json
tools/benchmark/results/

# One-off probes written while building the gate/benchmark; print real memory text.
tools/_probe-junk.mjs
tools/_probe-magnitudes.mjs
tools/_probe-miss.mjs
tools/_probe-cost.mjs

# Local backup of removed junk subagent sessions (contains real transcript bytes)
_subagent-backup-*/

